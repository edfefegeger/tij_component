<?xml version="1.0" encoding="UTF-8"?>
<!--
  INFO.XML — сведения о компоненте для автозаполнения служебных полей.

  Файл читают:
    * подсистема БСП "Внешние компоненты" — функция
      ВнешниеКомпонентыСлужебный.ИнформацияОКомпонентеИзФайла() разбирает
      INFO.XML и заполняет поля карточки: Идентификатор, Наименование, Версия.
      Если файла нет, эти поля остаются пустыми, и карточка не записывается;
    * "1С:Библиотека подключаемого оборудования" (БПО) — при загрузке
      драйвера через "Драйверы оборудования".

  Атрибуты (все обязательны по стандарту БПО):
    progid  — идентификатор объекта компоненты. Именно это значение (без
              префикса "AddIn.") попадает в поле "Идентификатор" карточки
              и по нему компонента подключается из кода.
    type    — тип оборудования из таблицы стандарта БПО. Допускается RU и EN,
              рекомендуется EN; несколько значений — через запятую.
    name    — наименование, которое увидит пользователь.
    version — версия поставляемой компоненты.

  При выпуске новой версии компоненты меняйте только атрибут version.
  Значение progid менять нельзя: оно привязано к имени, которое компонента
  регистрирует во встроенном языке (RegisterExtensionAs / GetClassNames
  возвращают "TIJPrinter", поэтому progid = AddIn.TIJPrinter).
-->
<drivers>
  <component progid="AddIn.TIJPrinter"
             type="LabelPrinter"
             name="Принтер линии TIJ"
             version="1.0.0.0"/>
</drivers>
